# Server Configuration
PORT=20129
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Infrastructure
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379

# Voyage AI (for embeddings)
VOYAGE_API_KEY=your-voyage-api-key

# ============================================================================
# ACCOUNT CONFIGURATION
# ============================================================================
# ClaudeFlow supports THREE account types:
#
# 1. Direct Anthropic (RECOMMENDED)
#    - Most reliable, no format conversion
#    - Format: ANTHROPIC_API_KEY_N=sk-ant-api03-...
#
# 2. Anthropic-Compatible Proxy
#    - ONLY for true MITM proxies that preserve raw Anthropic format
#    - NOT for 9router (converts to OpenAI format - NOT SUPPORTED)
#    - Format: PROXY_API_KEY_N=your-key, PROXY_BASE_URL_N=http://...
#
# 3. OAuth (Kiro accounts)
#    - For backward compatibility with existing OAuth setups
#    - Format: KIRO_MACHINE_ID_N=..., KIRO_API_KEY_N=..., KIRO_MITM_ROUTER_URL_N=...
#
# ⚠️  CRITICAL: All accounts MUST return raw Anthropic format responses.
#     ClaudeFlow will reject non-Anthropic format responses (e.g., OpenAI format).
# ============================================================================

# Direct Anthropic Accounts (RECOMMENDED)
ANTHROPIC_API_KEY_1=sk-ant-api03-your-key-1
ANTHROPIC_API_KEY_2=sk-ant-api03-your-key-2

# Anthropic-Compatible Proxy Accounts
# ⚠️  WARNING: Only use with proxies that return raw Anthropic format
# ❌ NOT SUPPORTED: 9router (converts to OpenAI format)
PROXY_API_KEY_1=your-proxy-api-key-1
PROXY_BASE_URL_1=http://localhost:8080

PROXY_API_KEY_2=your-proxy-api-key-2
PROXY_BASE_URL_2=https://your-mitm-proxy.com

# OAuth Accounts (Kiro) - For backward compatibility
KIRO_MACHINE_ID_1=your-machine-id-1
KIRO_API_KEY_1=sk-ant-api03-your-kiro-key-1
KIRO_MITM_ROUTER_URL_1=http://3.68.219.151:20128

KIRO_MACHINE_ID_2=your-machine-id-2
KIRO_API_KEY_2=sk-ant-api03-your-kiro-key-2
KIRO_MITM_ROUTER_URL_2=http://3.68.219.151:20128

# Optional: Configuration file path
CONFIG_PATH=./config.json
