{
  "server": {
    "port": 20129,
    "host": "0.0.0.0",
    "logLevel": "info"
  },
  "infrastructure": {
    "qdrant": {
      "url": "http://localhost:6333"
    },
    "redis": {
      "url": "redis://localhost:6379"
    },
    "voyage": {
      "apiKey": "your-voyage-api-key"
    }
  },
  "accounts": [
    {
      "id": "anthropic-account-1",
      "apiKey": "sk-ant-api03-...",
      "provider": "anthropic",
      "_comment": "Direct Anthropic account (RECOMMENDED) - Most reliable, no format conversion"
    },
    {
      "id": "anthropic-account-2",
      "apiKey": "sk-ant-api03-...",
      "provider": "anthropic",
      "_comment": "Add multiple Anthropic accounts for load balancing"
    },
    {
      "id": "proxy-account-1",
      "apiKey": "your-proxy-api-key",
      "baseURL": "http://localhost:8080",
      "provider": "proxy",
      "_comment": "CRITICAL: Proxy MUST return raw Anthropic format. NOT for 9router (converts to OpenAI format)."
    },
    {
      "id": "proxy-account-2",
      "apiKey": "your-proxy-api-key",
      "baseURL": "https://your-mitm-proxy.com",
      "provider": "proxy",
      "_comment": "Only use with true MITM proxies that preserve Anthropic format unchanged"
    },
    {
      "id": "oauth-account-1",
      "apiKey": "sk-ant-api03-...",
      "provider": "kiro",
      "kiroConfig": {
        "machineId": "your-machine-id-1",
        "mitmRouterUrl": "http://3.68.219.151:20128"
      },
      "_comment": "OAuth account (Kiro) - For backward compatibility with existing OAuth setups"
    },
    {
      "id": "oauth-account-2",
      "apiKey": "sk-ant-api03-...",
      "provider": "kiro",
      "kiroConfig": {
        "machineId": "your-machine-id-2",
        "mitmRouterUrl": "http://3.68.219.151:20128",
        "combo": {
          "accounts": ["account-a", "account-b", "account-c"],
          "strategy": "round-robin"
        }
      },
      "_comment": "OAuth account with combo (account pooling) for load balancing"
    }
  ],
  "optimization": {
    "semanticDeduplication": {
      "enabled": true,
      "similarityThreshold": 0.95,
      "cacheTTL": 86400
    },
    "promptCaching": {
      "enabled": true,
      "minTokens": 1024
    },
    "thinkingBudget": {
      "enabled": true,
      "simple": 0,
      "moderate": 2000,
      "complex": 10000
    },
    "contextCompression": {
      "enabled": true,
      "minTokens": 8000,
      "recentMessagesToKeep": 3
    }
  }
}
