# Server
PORT=20129
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# API authentication
# Comma-separated API keys for protected API/dashboard routes.
# Leave empty only for local development.
CLAUDEFLOW_API_KEYS=your-api-key-1,your-api-key-2

# Infrastructure
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379

# Embeddings
VOYAGE_API_KEY=your-voyage-api-key

# ============================================================================
# Account configuration
# ============================================================================
# ClaudeFlow supports three account sources:
#
# 1. Direct Anthropic API keys
#    Recommended for reliability.
#
# 2. Anthropic-compatible proxies
#    Only use proxies that preserve native Anthropic format.
#    Proxies that convert to OpenAI-compatible responses are not supported.
#
# 3. Kiro OAuth accounts
#    Prefer the CLI login flow. Legacy environment-based Kiro settings remain
#    available for compatibility with older setups.
#
# All providers must return native Anthropic responses. ClaudeFlow rejects
# incompatible response shapes.
# ============================================================================

# Direct Anthropic accounts
ANTHROPIC_API_KEY_1=sk-ant-api03-your-key-1
ANTHROPIC_API_KEY_2=sk-ant-api03-your-key-2

# Anthropic-compatible proxy accounts
PROXY_API_KEY_1=your-proxy-api-key-1
PROXY_BASE_URL_1=http://localhost:8080

PROXY_API_KEY_2=your-proxy-api-key-2
PROXY_BASE_URL_2=https://your-mitm-proxy.com

# Legacy Kiro OAuth accounts
KIRO_MACHINE_ID_1=your-machine-id-1
KIRO_API_KEY_1=sk-ant-api03-your-kiro-key-1
KIRO_MITM_ROUTER_URL_1=http://3.68.219.151:20128

KIRO_MACHINE_ID_2=your-machine-id-2
KIRO_API_KEY_2=sk-ant-api03-your-kiro-key-2
KIRO_MITM_ROUTER_URL_2=http://3.68.219.151:20128

# Optional config file override
CONFIG_PATH=./config.json
