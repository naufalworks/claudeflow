{
  "name": "claudeflow",
  "version": "0.1.0",
  "description": "Intelligent API router optimized for Anthropic's Claude models",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "claudeflow": "./dist/cli/bin/claudeflow.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "verify": "tsx src/scripts/verify-infrastructure.ts"
  },
  "keywords": [
    "anthropic",
    "claude",
    "api-router",
    "optimization",
    "caching"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "@fastify/cors": "^9.0.1",
    "@inquirer/prompts": "^8.4.2",
    "@qdrant/js-client-rest": "^1.8.2",
    "axios": "^1.6.8",
    "better-sqlite3": "^12.9.0",
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.11.0",
    "chalk": "^5.6.2",
    "cli-progress": "^3.12.0",
    "cli-spinners": "^3.4.0",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.26.2",
    "figlet": "^1.11.0",
    "inquirer": "^13.4.2",
    "ioredis": "^5.3.2",
    "jose": "^6.2.3",
    "keytar": "^7.9.0",
    "lowdb": "^7.0.1",
    "ora": "^9.4.0",
    "pino": "^8.19.0",
    "pino-pretty": "^11.0.0",
    "pm2": "^7.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/blessed": "^0.1.27",
    "@types/inquirer": "^9.0.9",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "^7.6.0",
    "@typescript-eslint/parser": "^7.6.0",
    "depcheck": "^1.4.7",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "fast-check": "^4.7.0",
    "ioredis-mock": "^8.13.1",
    "jest": "^29.7.0",
    "jscpd": "^4.0.9",
    "license-checker": "^25.0.1",
    "madge": "^8.0.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
