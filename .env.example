# Server Configuration
PORT=20129
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Infrastructure
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379

# Voyage AI (for embeddings)
VOYAGE_API_KEY=your-voyage-api-key

# Anthropic Accounts (add multiple for multi-account support)
ANTHROPIC_API_KEY_1=your-anthropic-api-key-1
ANTHROPIC_API_KEY_2=your-anthropic-api-key-2

# Kiro Accounts (OAuth-based accounts via MITM router)
# Format: KIRO_MACHINE_ID_N, KIRO_API_KEY_N, KIRO_MITM_ROUTER_URL_N (optional)
KIRO_MACHINE_ID_1=your-machine-id-1
KIRO_API_KEY_1=your-kiro-api-key-1
KIRO_MITM_ROUTER_URL_1=http://3.68.219.151:20128

KIRO_MACHINE_ID_2=your-machine-id-2
KIRO_API_KEY_2=your-kiro-api-key-2
KIRO_MITM_ROUTER_URL_2=http://3.68.219.151:20128

# Optional: Configuration file path
CONFIG_PATH=./config.json
