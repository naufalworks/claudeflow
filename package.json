{
  "name": "claudeflow",
  "version": "0.1.0",
  "description": "Intelligent API router optimized for Anthropic's Claude models",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "claudeflow": "./dist/cli/bin/claudeflow.js"
  },
  "scripts": {
    "dev": "npm run dev:clean && concurrently \"npm run dev:api\" \"npm run dev:web\" --names \"API,WEB\" --prefix-colors \"cyan,magenta\"",
    "dev:clean": "node scripts/kill-dev-ports.cjs",
    "dev:api": "tsx watch src/index.ts",
    "dev:web": "cd web && npm run dev",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc",
    "build:web": "cd web && npm run build",
    "start": "concurrently \"npm run start:api\" \"npm run start:web\" --names \"API,WEB\" --prefix-colors \"cyan,magenta\"",
    "start:api": "node dist/index.js",
    "start:web": "cd web && npm start",
    "start:background": "claudeflow daemon start",
    "stop:background": "claudeflow daemon stop",
    "restart:background": "claudeflow daemon restart",
    "background:status": "claudeflow daemon status",
    "background:logs": "claudeflow logs -f",
    "autostart:enable": "claudeflow autostart enable",
    "autostart:disable": "claudeflow autostart disable",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "verify": "tsx src/scripts/verify-infrastructure.ts"
  },
  "keywords": [
    "anthropic",
    "claude",
    "api-router",
    "optimization",
    "caching"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@inquirer/prompts": "^8.4.2",
    "@qdrant/js-client-rest": "^1.8.2",
    "@types/sql.js": "^1.4.11",
    "axios": "^1.6.8",
    "better-sqlite3": "^12.9.0",
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.8.13",
    "chalk": "^5.6.2",
    "cli-progress": "^3.12.0",
    "cli-spinners": "^3.4.0",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.8.5",
    "figlet": "^1.11.0",
    "inquirer": "^13.4.2",
    "ioredis": "^5.3.2",
    "jose": "^6.2.3",
    "keytar": "^7.9.0",
    "lowdb": "^7.0.1",
    "node-cron": "^4.2.1",
    "open": "^11.0.0",
    "ora": "^9.4.0",
    "pino": "^8.19.0",
    "pino-pretty": "^11.0.0",
    "pm2": "^7.0.0",
    "sql.js": "^1.14.1",
    "ws": "^8.20.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/blessed": "^0.1.27",
    "@types/inquirer": "^9.0.9",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.6.0",
    "@typescript-eslint/parser": "^7.6.0",
    "concurrently": "^9.2.1",
    "depcheck": "^1.4.7",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "fast-check": "^4.7.0",
    "ioredis-mock": "^8.13.1",
    "jest": "^29.7.0",
    "jscpd": "^4.0.9",
    "license-checker": "^25.0.1",
    "madge": "^8.0.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
